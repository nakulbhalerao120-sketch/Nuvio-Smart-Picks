+    private val theater = Regex("""(?i)\b(cam|hdcam|telesync|hdts|telecine|camrip)\b""")
+    private val clean = Regex("""(?i)\b(web[ ._-]?(dl|rip)|blu[ ._-]?ray|b[dr]rip|remux)\b""")
+    private val languages = listOf(
+        Regex("""(?i)(?<![\p{L}\p{N}])(hi|hin|hind|hindi|हिंदी|हिन्दी)(?![\p{L}\p{N}])"""),
+        Regex("""(?i)(?<![\p{L}\p{N}])(mr|mar|marathi|मराठी)(?![\p{L}\p{N}])"""),
+        Regex("""(?i)\b(en|eng|english)\b""")
+    )
+
+    private data class Attempt(val url: String, val remaining: List<Stream>, val startedAt: Long)
+    private var attempt: Attempt? = null
+
+    @Synchronized
+    fun playBest(streams: List<Stream>): Stream? {
+        val eligible = streams.filter(::isPlayable)
+        val first = BestFilters.choose(eligible, ::bestRank)
+        attempt = first?.getStreamUrl()?.let { url ->
+            Attempt(url, eligible.filter { it.getStreamUrl() != url }, System.nanoTime())
+        }
+        return first
+    }
+
+    @Synchronized
+    internal fun nextAfterFailure(url: String): Stream? {
+        val selection = attempt ?: return null
+        if (selection.url != url || System.nanoTime() - selection.startedAt > 120_000_000_000L) return null
+        return playBest(selection.remaining)
+    }
+
+    private fun bestRank(stream: Stream): Int {
+        val label = listOfNotNull(stream.name, stream.title, stream.description, stream.behaviorHints?.filename).joinToString(" ")
+        val quality = when {
+            theater.containsMatchIn(label) -> 2
+            clean.containsMatchIn(label) -> 0
+            else -> 1
+        }
+        val language = languages.indexOfFirst { it.containsMatchIn(label) }
+        return quality * 4 + if (language >= 0) language else 3
+    }
+
