+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.TimeUnit
+
+internal object OfficialTrailerDirectory {
+    // Exact publisher handles returned by YouTube oEmbed. Display names are editable and ambiguous.
+    private val publishers = setOf(
+        "suntv", "aashirvadcinemasofficial", "warnerbrosindia", "warnerbrospictures", "dc", "dcofficial",
+        "sonypicturesindia", "sonypictures", "paramountpicturesindia", "paramountpictures",
+        "universalpicturesindia", "universalpictures", "universalpicturesuk", "lionsgatemovies",
+        "marvelindia", "marvel", "disneyindia", "disney", "disneyplus", "pixar",
+        "20thcenturystudiosindia", "20thcenturystudios", "searchlightpictures",
+        "netflixindiaofficial", "netflix", "primevideoin", "primevideo", "appletv", "hbo", "hbomax",
+        "jiohotstar", "sonyliv", "zee5", "yrf", "tseries", "dharmamovies", "redchilliesentertainment",
+        "maddockfilms", "excelmovies", "zeestudiosofficial", "rajshri", "jiostudios", "sonymusicindia"
+    )
+    private val bad = Regex("""(?i)\b(fan[ -]?(made|dub(bed)?|trailer)|concept|reaction|parody|review|recap|ai[ -]?(dub(bed)?|trailer))\b""")
+    private val subtitles = Regex("""(?i)(hindi|marathi)\s+(subtitles?|subs?|caption)|subtitled\s+in""")
+    private val trailer = Regex("""(?i)\b(trailer|teaser)\b|ट्रेलर|टीज़र""")
+    private val videoKey = Regex("[A-Za-z0-9_-]{11}")
+    private val http = OkHttpClient.Builder().callTimeout(5, TimeUnit.SECONDS).build()
+    private val searchHttp = http.newBuilder().callTimeout(20, TimeUnit.SECONDS).build()
+    private val descriptions = ConcurrentHashMap<String, String>()
+    fun acceptedTitle(handle: String, title: String): Boolean =
+        handle.lowercase() in publishers && trailer.containsMatchIn(title) && !bad.containsMatchIn(title)
+    fun localized(title: String, language: String): Boolean =
+        !subtitles.containsMatchIn(title) && (if (language == "mr") Regex("(?i)\\bmarathi\\b|मराठी")
+        else Regex("(?i)\\bhindi\\b|हिंदी|हिन्दी")).containsMatchIn(title)
+    private fun fetch(url: okhttp3.HttpUrl, client: OkHttpClient = http): String? = try {
+        client.newCall(Request.Builder().url(url).header("Accept-Language","en-IN,en").build()).execute().use {
+            if (it.isSuccessful) it.body?.string() else null
+        }
+    } catch (_: IOException) { null }
+    fun publisherTitle(key: String): String? {
+        descriptions[key]?.let { return it }
+        if (!videoKey.matches(key)) return null
+        val url = "https://www.youtube.com/oembed".toHttpUrl().newBuilder()
+            .addQueryParameter("url","https://www.youtube.com/watch?v=$key").addQueryParameter("format","json").build()
+        val data = fetch(url) ?: return null
+        val obj = runCatching { JsonParser.parseString(data).asJsonObject }.getOrNull() ?: return null
+        val author = obj.get("author_url")?.asString?.let { runCatching { it.toHttpUrl() }.getOrNull() } ?: return null
+        if (author.host !in setOf("youtube.com","www.youtube.com")) return null
+        val title = obj.get("title")?.asString ?: return null
+        if (!acceptedTitle(author.encodedPath.removePrefix("/@"), title)) return null
+        if (descriptions.size >= 256) descriptions.clear()
+        descriptions[key] = title
+        return title
+    }
+    internal fun titleMatches(upload: String, movie: String): Boolean {
+        val title = movie.replace(Regex("[:：]\\s*"), " ").trim()
+        val normalizedUpload = upload.replace(Regex("[:：]\\s*"), " ")
+        if (title.isEmpty()) return false
+        val at = normalizedUpload.indexOf(title, ignoreCase = true)
+        if (at < 0) return false
+        val prefix = normalizedUpload.substring(0, at).trimEnd()
+        if (prefix.isNotEmpty() && !prefix.endsWith("(")) return false
+        val suffix = normalizedUpload.substring(at + title.length).trimStart()
+        return suffix.isEmpty() || suffix.first() in "|)-–—([" ||
+            Regex("(?i)^(official|hindi|marathi|trailer|teaser)\\b").containsMatchIn(suffix)
+    }
+    fun discover(movie: String, year: String?, language: String): List<String> {
+        val query = listOfNotNull(movie, year, when (language) { "mr" -> "official Marathi trailer"; "hi" -> "official Hindi trailer"; else -> "official trailer" }).joinToString(" ")
+        val url = "https://www.youtube.com/results".toHttpUrl().newBuilder().addQueryParameter("search_query",query).build()
+        val html = fetch(url, searchHttp) ?: return emptyList()
+        val match = Regex("""(?:var\s+ytInitialData\s*=\s*|window\["ytInitialData"\]\s*=\s*)""").find(html) ?: return emptyList()
+        val root = runCatching { JsonParser.parseReader(JsonReader(StringReader(html.substring(match.range.last+1)))) }.getOrNull() ?: return emptyList()
+        val ids = mutableListOf<String>()
+        fun visit(node: JsonElement) {
+            if (ids.size >= 12) return
+            if (node.isJsonArray) node.asJsonArray.forEach(::visit)
+            if (!node.isJsonObject) return
+            val obj = node.asJsonObject
+            val video = obj.getAsJsonObject("videoRenderer")
+            val card = obj.getAsJsonObject("lockupViewModel")
+            val key: String
+            val name: String
+            when {
+                card != null -> {
+                    key = card.get("contentId")?.asString ?: return
+                    name = card.getAsJsonObject("metadata")?.getAsJsonObject("lockupMetadataViewModel")
+                        ?.getAsJsonObject("title")?.get("content")?.asString ?: return
+                }
+                video != null -> {
+                    key = video.get("videoId")?.asString ?: return
+                    name = video.getAsJsonObject("title")?.getAsJsonArray("runs")
+                        ?.joinToString("") { it.asJsonObject.get("text")?.asString.orEmpty() } ?: return
+                }
+                else -> { obj.entrySet().forEach { visit(it.value) }; return }
+            }
+            if ((language.isEmpty() || localized(name,language)) && titleMatches(name,movie) && trailer.containsMatchIn(name) && !bad.containsMatchIn(name)) ids.add(key)
+        }
+        visit(root)
+        return ids.distinct().asSequence().filter { key ->
+            publisherTitle(key)?.let { (language.isEmpty() || localized(it,language)) && titleMatches(it,movie) } == true
+        }.take(2).toList()
+    }
+}
