diff --git a/app/src/main/java/com/nuvio/tv/core/player/BestFilters.kt b/app/src/main/java/com/nuvio/tv/core/player/BestFilters.kt
new file mode 100644
index 0000000..8cfc5d2
--- /dev/null
+++ b/app/src/main/java/com/nuvio/tv/core/player/BestFilters.kt
@@ -0,0 +1,75 @@
+package com.nuvio.tv.core.player
+
+import android.app.AlertDialog
+import android.content.Context
+import com.nuvio.tv.domain.model.Stream
+
+internal object BestFilters {
+    private lateinit var prefs: android.content.SharedPreferences
+    fun init(context: Context) {
+        prefs = context.getSharedPreferences("play_best_filters", Context.MODE_PRIVATE)
+    }
+    private val choices = linkedMapOf(
+        "Resolution" to listOf("Any", "Up to 1080p", "1080p only", "4K only"),
+        "Dynamic range" to listOf("Any", "SDR preferred", "Exclude labelled HDR"),
+        "IMAX" to listOf("Off", "Prefer IMAX", "IMAX only"),
+        "File size" to listOf("Off", "Prefer larger", "Largest only"),
+        "File size limit" to listOf("Any", "5 GB", "10 GB", "20 GB", "30 GB"),
+        "Video codec" to listOf("Any", "H.264", "HEVC", "AV1"),
+        "Source" to listOf("Any", "WEB-DL", "WEBRip", "Blu-ray", "Remux"),
+        "Audio format" to listOf("Any", "Atmos", "DD / DD+", "DTS / TrueHD", "Stereo"),
+        "Instant only" to listOf("Off", "On"),
+        "Theater copies" to listOf("Allow as fallback", "Hide")
+    )
+    fun show(context: Context, changed: () -> Unit = {}) {
+        val names = choices.keys.toList()
+        AlertDialog.Builder(context).setTitle("Play Best filters")
+            .setItems(names.map { "$it  ·  ${choices.getValue(it)[index(it)]}" }.toTypedArray()) { _, i ->
+                val key = names[i]
+                AlertDialog.Builder(context).setTitle(key)
+                    .setSingleChoiceItems(choices.getValue(key).toTypedArray(), index(key)) { dialog, n ->
+                        prefs.edit().putInt(key, n).apply()
+                        dialog.dismiss()
+                        changed()
+                        show(context, changed)
+                    }.setNegativeButton("Back") { _, _ -> show(context, changed) }.show()
+            }.setNegativeButton("Done", null).show()
+    }
+    private fun index(key: String) = if (::prefs.isInitialized) prefs.getInt(key, 0) else 0
+    private val hdr = Regex("dolby[ ._-]*vision|\\bhdr|\\bdv\\b", RegexOption.IGNORE_CASE)
+    private val size = Regex("""(?i)(\d+(?:[.,]\d+)?)\s*(GB|GiB|MB|MiB)\b""")
+    private data class Candidate(val stream: Stream, val rank: Int, val imax: Boolean, val hdr: Boolean, val bytes: Long)
+    fun choose(streams: List<Stream>, rank: (Stream) -> Int): Stream? {
+        val resolution = index("Resolution")
+        val range = index("Dynamic range")
+        val imaxMode = index("IMAX")
+        val sizeMode = index("File size")
+        val codec = listOf("", "h264|x264|avc", "hevc|h265|x265", "av1")[index("Video codec")].toRegex()
+        val source = listOf("", "webdl", "webrip", "bluray|bdrip", "remux")[index("Source")].toRegex()
+        val cap = listOf(0,5,10,20,30)[index("File size limit")] * 1_000_000_000L
+        val audio = listOf("", "atmos", "dd[+]|ddp|eac3|ac3|dolbydigital|dd5", "dts|truehd", "stereo|20ch|2ch")[index("Audio format")].toRegex()
+        val instant = index("Instant only") == 1
+        val hideCam = index("Theater copies") == 1
+        val candidates = streams.mapNotNull { s ->
+            val text = listOfNotNull(s.quality,s.name,s.title,s.description,s.behaviorHints?.filename).joinToString(" ").lowercase()
+            val compact = text.replace(Regex("[ ._-]+"), "")
+            val fourK = text.contains("2160") || text.contains("4k")
+            val imax = text.contains("imax")
+            val isHdr = hdr.containsMatchIn(text)
+            val r = rank(s)
+            val bytes = s.behaviorHints?.videoSize?.takeIf { it > 0 } ?: size.find(text)?.let {
+                (it.groupValues[1].replace(',', '.').toDouble() * (if (it.groupValues[2].startsWith("g",true)) 1e9 else 1e6)).toLong()
+            } ?: 0L
+            if ((instant && s.getStreamUrl() == null && s.debridCacheStatus?.state != com.nuvio.tv.domain.model.StreamDebridCacheState.CACHED) || !audio.containsMatchIn(compact) ||
+                (resolution == 1 && (fourK || text.contains("4320") || text.contains("8k") || text.contains("1440"))) ||
+                (resolution == 2 && !text.contains("1080")) || (resolution == 3 && !fourK) ||
+                (range == 2 && isHdr) || (imaxMode == 2 && !imax) || (hideCam && r >= 8) ||
+                (cap > 0 && bytes > cap) || !codec.containsMatchIn(compact) || !source.containsMatchIn(compact)) null
+            else Candidate(s,r,imax,isHdr,bytes)
+        }
+        val largest = if (sizeMode == 2) candidates.maxOfOrNull { it.bytes } else null
+        return candidates.asSequence().filter { largest == null || it.bytes == largest }
+            .minWithOrNull(compareBy<Candidate> { it.rank }.thenBy { range == 1 && it.hdr }
+                .thenBy { imaxMode == 1 && !it.imax }.thenByDescending { if (sizeMode == 1) it.bytes else 0L })?.stream
+    }
+}
