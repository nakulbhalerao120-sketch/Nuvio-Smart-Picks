@@ -0,0 +1,26 @@
+package com.nuvio.tv.data.trailer
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class OfficialTrailerDirectoryTest {
+    @Test fun studioHindiUploadMatchesEvenWithDevanagariTitle() {
+        val title = "क्लेफेस (Clayface) | Official Hindi Trailer"
+        assertTrue(OfficialTrailerDirectory.acceptedTitle("WarnerBrosIndia", title))
+        assertTrue(OfficialTrailerDirectory.titleMatches(title, "Clayface"))
+        assertTrue(OfficialTrailerDirectory.localized(title, "hi"))
+    }
+
+    @Test fun aFanCannotImpersonateThePublisherInTheirTitle() {
+        assertFalse(OfficialTrailerDirectory.acceptedTitle("WarnerBrosIndiaFans", "Clayface Official Hindi Trailer"))
+        assertFalse(OfficialTrailerDirectory.acceptedTitle("WarnerBrosIndia", "Clayface Fan Dubbed Trailer"))
+        assertFalse(OfficialTrailerDirectory.localized("Official Trailer with Hindi subtitles", "hi"))
+    }
+
+    @Test fun sequelDifferentMovieAndWrongDubAreRejected() {
+        assertFalse(OfficialTrailerDirectory.titleMatches("Transformers 2 Official Hindi Trailer", "Transformers"))
+        assertFalse(OfficialTrailerDirectory.titleMatches("The Batman | Official Hindi Trailer", "Batman"))
+        assertFalse(OfficialTrailerDirectory.localized("Official Hindi Trailer", "mr"))
+        assertTrue(OfficialTrailerDirectory.localized("Official Marathi Trailer", "mr"))
+    }
+}
